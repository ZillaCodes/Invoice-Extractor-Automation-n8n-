    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\n\nlet raw;\nif (response.candidates && response.candidates[0] && response.candidates[0].content) {\n  // Gemini shape\n  raw = response.candidates[0].content.parts[0].text;\n} else if (response.content && response.content[0] && response.content[0].text) {\n  // Claude shape\n  raw = response.content[0].text;\n} else if (response.text) {\n  raw = response.text;\n} else {\n  throw new Error('Unexpected structure: ' + JSON.stringify(response).slice(0, 500));\n}\n\nconst cleaned = raw.replace(/```json|```/g, '').trim();\nconst parsed = JSON.parse(cleaned);\n\nconst lineItems = parsed.line_items || [];\nconst computedTotal = lineItems.reduce((sum, item) => sum + (Number(item.amount) || 0), 0);\nconst statedTotal = Number(parsed.stated_total) || 0;\nconst mismatch = Math.abs(computedTotal - statedTotal) > 0.01;\n\nreturn [{\n  json: {\n    vendor: parsed.vendor || 'Unknown',\n    invoice_number: parsed.invoice_number || 'Unknown',\n    invoice_date: parsed.invoice_date || null,\n    category: parsed.category || 'Other',\n    stated_total: statedTotal,\n    computed_total: computedTotal,\n    total_mismatch: mismatch,\n    line_items: lineItems\n  }\n}];"
      },
