    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst now = new Date();\nconst currentMonth = now.getMonth();\nconst currentYear = now.getFullYear();\n\nlet totalCount = 0;\nlet totalAmount = 0;\nconst categoryTotals = {};\n\nfor (const item of items) {\n  const row = item.json;\n  const invoiceDate = new Date(row.Date);\n  \n  if (isNaN(invoiceDate.getTime())) continue;\n  \n  // Only count invoices from last month\n  if (invoiceDate.getMonth() === currentMonth && invoiceDate.getFullYear() === currentYear) {\n    totalCount++;\n    const total = Number(row.Total) || 0;\n    totalAmount += total;\n    \n    const category = row.Category || 'Other';\n    categoryTotals[category] = (categoryTotals[category] || 0) + total;\n  }\n}\n\n// Find top category\nlet topCategory = 'None';\nlet topAmount = 0;\nfor (const [cat, amt] of Object.entries(categoryTotals)) {\n  if (amt > topAmount) {\n    topCategory = cat;\n    topAmount = amt;\n  }\n}\n\nreturn [{\n  json: {\n    total_count: totalCount,\n    total_amount: totalAmount,\n    top_category: topCategory,\n    top_category_amount: topAmount\n  }\n}];"
      },
