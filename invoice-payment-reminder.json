        "googleSheetsOAuth2Api": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst now = new Date();\nconst overdueThresholdDays = 7;\n\nconst overdue = [];\n\nfor (const item of items) {\n  const row = item.json;\n  \n  // Skip anything already marked Paid\n  if (row.Status !== 'Pending') continue;\n  \n  // Parse the invoice date\n  const invoiceDate = new Date(row.Date);\n  if (isNaN(invoiceDate.getTime())) continue; // skip if date is unreadable\n  \n  const daysPending = Math.floor((now - invoiceDate) / (1000 * 60 * 60 * 24));\n  \n  if (daysPending >= overdueThresholdDays) {\n    overdue.push({\n      json: {\n        vendor: row.Vendor,\n        invoice_number: row['Invoice Number'],\n        total: row.Total,\n        days_pending: daysPending\n      }\n    });\n  }\n}\n\nreturn overdue;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
